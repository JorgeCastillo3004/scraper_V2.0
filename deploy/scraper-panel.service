# scraper-panel.service — API FastAPI :8009 + frontend (ver/configurar)
# Plano de control delgado: escribe CONFIG.json / run_control_*.json y lee estado.
# NO corre el scheduler (lo hace scraper-engine) → ENGINE_OWNS_SCHEDULER=1.
# Instalar (sudo UNA vez):
#   sudo cp deploy/scraper-panel.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now scraper-panel
[Unit]
Description=Scraper panel (API FastAPI + frontend)
After=network-online.target scraper-engine.service
Wants=network-online.target

[Service]
Type=simple
User=jorge
WorkingDirectory=/home/jorge/work/scraper_V2.0
Environment=ENGINE_OWNS_SCHEDULER=1
Environment=NO_RICH=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jorge/work/scraper_V2.0/env_sports/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8009
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
